# Booking form (src/app/api/book/route.ts) sends enquiries by email through Resend (https://resend.com).
# Copy this file to .env.local for local use, and add the same three variables in Vercel
# (Project → Settings → Environment Variables) for the live site.

# Resend API key: Resend dashboard → API Keys → Create API key ("Sending access" is enough).
RESEND_API_KEY=

# Who the enquiry emails come from. The domain must be verified in Resend (Domains → Add domain,
# then add the DNS records it shows). Until it is verified, "onboarding@resend.dev" works for testing,
# but Resend then only delivers to the email address of the Resend account itself.
CONTACT_FROM="On Point Website <bookings@onpointcosmetictattoo.com.au>"

# Where enquiries are delivered. Several addresses can be separated by commas.
CONTACT_TO=onpointcosmetictattoo@gmail.com
